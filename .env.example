# LLM Provider Configuration
# Options: "openrouter" or "anthropic"
LLM_PROVIDER=openrouter

# OpenRouter API Key
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key-here

# Anthropic API Key (if using Anthropic directly)
# Get from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=

# LLM Model Name
# For OpenRouter: "claude-3.5-sonnet", "claude-3-sonnet", "gpt-4", etc.
# For Anthropic: "claude-3-5-sonnet-20241022", "claude-3-opus-20240229", etc.
LLM_MODEL=claude-3.5-sonnet

# LLM Parameters
MAX_TOKENS=4096
TEMPERATURE=0.7
